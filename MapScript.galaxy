        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_FirstTimePopupClose, true);
    Wait(0.5, c_timeReal);
    gf_CreateFirstTimePopup();
    libNtve_gf_SetDialogItemText(gv_firstTimePopupHeader, libAA0EBE8C_gv_sCMRLauncher.lv_popupAudioHeader, PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_firstTimePopupText, libAA0EBE8C_gv_sCMRLauncher.lv_popupAudio, PlayerGroupAll());

void gf_MenuBackground (int lp_menuBackground) {
    // Automatic Variable Declarations
    // Implementation
    TriggerStop(gt_MenuBackgroundLightTrip);
    TriggerStop(gt_MenuBackgroundCamCity);
    TriggerStop(gt_MenuBackgroundCamBirdseye);
    if ((lp_menuBackground == 1)) {
        CameraApplyInfo(1, CameraInfoFromId(1), 0.0, -1, 10.0, true);
        GameSetBackground(c_backgroundFixed, "AvernusSkybox", 100.0);
        GameSetLighting("SCMR", 0.0);
    }
    else {
        if ((lp_menuBackground == 2)) {
            CameraApplyInfo(1, CameraInfoFromId(10), 0.0, -1, 10.0, true);
            GameSetBackground(c_backgroundFixed, "KorhalSkyboxHorizon", 100.0);
            GameSetLighting("SCMRCity", 0.0);
        }
        else {
            if ((lp_menuBackground == 3)) {
                CameraApplyInfo(1, CameraInfoFromId(815960109), 0.0, -1, 10.0, true);
                GameSetBackground(c_backgroundFixed, "KorhalCitySkybox", 100.0);
                GameSetLighting("SCMRCity", 0.0);
                TriggerExecute(gt_MenuBackgroundCamCity, false, false);
            }
            else {
                if ((lp_menuBackground == 4)) {
                    CameraApplyInfo(1, CameraInfoFromId(11), 0.0, -1, 10.0, true);
                    GameSetBackground(c_backgroundFixed, "CharSkyBox", 100.0);
                    GameSetLighting("SCMRChar", 0.0);
                }
                else {
                    if ((lp_menuBackground == 5)) {
                        CameraApplyInfo(1, CameraInfoFromId(12), 0.0, -1, 10.0, true);
                        GameSetBackground(c_backgroundFixed, "AvernusSkybox", 100.0);
                        GameSetLighting("SCMRDawn", 0.0);
                    }
                    else {
                        if ((lp_menuBackground == 6)) {
                            CameraApplyInfo(1, CameraInfoFromId(13), 0.0, -1, 10.0, true);
                            GameSetBackground(c_backgroundFixed, "VC_Zeratul1_Sky", 10.0);
                            GameSetLighting("SCMR", 0.0);
                            TriggerExecute(gt_MenuBackgroundLightTrip, false, false);
                        }
                        else {
                            if ((lp_menuBackground == 7)) {
                                CameraApplyInfo(1, CameraInfoFromId(14), 0.0, -1, 10.0, true);
                                GameSetBackground(c_backgroundFixed, "KorhalSkyboxCityNight", 20.0);
                                GameSetLighting("SCMRDark", 0.0);
                                TriggerExecute(gt_MenuBackgroundCamBirdseye, false, false);
                            }
                            else {
                                if ((lp_menuBackground == 8)) {
                                    CameraApplyInfo(1, CameraInfoFromId(15), 0.0, -1, 10.0, true);
                                    GameSetBackground(c_backgroundFixed, "SkyBoxPortZionSpace", 100.0);
                                    GameSetLighting("SCMR", 0.0);
                                }
                                else {
                                    if ((lp_menuBackground == 9)) {
                                        CameraApplyInfo(1, CameraInfoFromId(16), 0.0, -1, 10.0, true);
                                        GameSetBackground(c_backgroundFixed, "AiurSkybox", 100.0);
                                        GameSetLighting("SCMRSun", 0.0);
                                    }

                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

void gf_LoadOptions () {
    // Automatic Variable Declarations
    // Implementation
    BankReload(gv_sCMR);
    BankWait(gv_sCMR);
    gv_insaneDifficultyUnlocked = BankValueGetAsFlag(BankLastCreated(), "options", "insaneDifficultyUnlocked");
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll());
    DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyEasy);
    DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyNormal);
    DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyHard);
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll());
    if ((gv_iniCinematicsMod == true)) {
        DialogControlAddItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optInterludesSCR);
    }

    DialogControlAddItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optInterludesSCBW);
    DialogControlAddItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optInterludesSCMR);
    if ((BankValueGetAsFlag(gv_sCMR, "options", "PsiEmitters") == true)) {
        libNtve_gf_SetDialogItemChecked(gv_dialogOptions.lv_optPsiEmitters, true, PlayerGroupAll());
        DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyBrutal);
    }
    else {
        libNtve_gf_SetDialogItemChecked(gv_dialogOptions.lv_optPsiEmitters, false, PlayerGroupAll());
    }
    DialogControlSelectItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), BankValueGetAsInt(gv_sCMR, "options", "difficulty"));
    DialogControlSelectItem(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll(), BankValueGetAsInt(gv_sCMR, "options", "gamespeed"));
    if ((gv_iniCinematicsMod == true)) {
        DialogControlSelectItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), BankValueGetAsInt(gv_sCMR, "options", "InterstitialsNew"));
    }
    else {
        DialogControlSelectItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), (BankValueGetAsInt(gv_sCMR, "options", "InterstitialsNew") - 1));
    }

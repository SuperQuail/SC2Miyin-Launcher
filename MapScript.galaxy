//--------------------------------------------------------------------------------------------------
// Trigger: Play - Begin Campaign
//--------------------------------------------------------------------------------------------------
bool gt_PlayBeginCampaign_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_btnPlayBegin == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_beginningCampaign = true;
    gf_LoadingScreenTextBeginCampaign();
    if (((gv_selectedCampaign == 1) || (gv_selectedCampaign == 5))) {
        if ((BankValueGetAsFlag(gv_sCMR, "options", "Cinematics") == true)) {
            GameSetNextMap(("Starcraft Mass Recall/" + gv_campaign + gv_mission[(DialogControlGetSelectedItem(gv_missionselection, 1) + 1)]));
            TriggerExecute(gt_VideoStart, false, false);
        }
        else {
            GameSetNextMap(("Starcraft Mass Recall/" + gv_campaign + gv_mission[(DialogControlGetSelectedItem(gv_missionselection, 1) + 1)]));
            Wait(0.01, c_timeReal);
            DialogDestroyAll();
            GameOver(1, c_gameOverVictory, false, false);
        }
    }
    else {
        GameSetNextMap(("Starcraft Mass Recall/" + gv_campaign + gv_mission[DialogControlGetSelectedItem(gv_missionselection, 1)]));
        Wait(0.01, c_timeReal);
        DialogDestroyAll();
        GameOver(1, c_gameOverVictory, false, false);
    }
    return true;
}


            gf_SetDialogColorScheme("Assets\\Textures\\ui_battlenet_glue_navbuttons_orange_normalpressed.dds", "Assets\\Textures\\ui_battlenet_glue_navbuttons_orange_normaloverpressedover.dds", Color(100.00, 82.75, 65.88));

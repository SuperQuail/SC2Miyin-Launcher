trigger auto_gf_HideEpisodeButton_Trigger = null;
bool auto_gf_HideEpisodeButton_lp_showHide;
int auto_gf_HideEpisodeButton_lp_episodeButtonID;

void gf_HideEpisodeButton (bool lp_showHide, int lp_episodeButtonID) {
    auto_gf_HideEpisodeButton_lp_showHide = lp_showHide;
    auto_gf_HideEpisodeButton_lp_episodeButtonID = lp_episodeButtonID;

    if (auto_gf_HideEpisodeButton_Trigger == null) {
        auto_gf_HideEpisodeButton_Trigger = TriggerCreate("auto_gf_HideEpisodeButton_TriggerFunc");
    }

    TriggerExecute(auto_gf_HideEpisodeButton_Trigger, false, false);
}

bool auto_gf_HideEpisodeButton_TriggerFunc (bool testConds, bool runActions) {
    bool lp_showHide = auto_gf_HideEpisodeButton_lp_showHide;
    int lp_episodeButtonID = auto_gf_HideEpisodeButton_lp_episodeButtonID;

    // Automatic Variable Declarations
    // Implementation
    if ((gv_episodeButtons[lp_episodeButtonID].lv_btn == c_invalidDialogId)) {
        return true;
    }

    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_btn, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_epimg, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_epimghvr, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_img, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_lbl, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_cmp, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_prcnt, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_imgbtm, PlayerGroupAll(), lp_showHide);
    DialogControlSetVisible(gv_episodeButtons[lp_episodeButtonID].lv_imgtop, PlayerGroupAll(), lp_showHide);
    return true;
}

void gf_SetEpisodeCompletion (int lp_index, int lp_lastMap) {
    // Variable Declarations
    int[9] lv_pctCompleted;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    gv_episodeCompleted[lp_index] = FixedToInt(gv_stats.lv_progressPct[lp_index]);
    if ((gv_episodeCompleted[lp_index] <= 2)) {
        DialogControlSetVisible(gv_episodeButtons[lp_index].lv_prcnt, PlayerGroupAll(), false);
    }

}

void gf_ShowHideEpisodeCompletion (int lp_index) {
    // Variable Declarations
    int lv_currentMap;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if ((gv_episodeCompleted[lp_index] < 2)) {
        DialogControlSetVisible(gv_episodeButtons[lp_index].lv_prcnt, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[lp_index].lv_cmp, PlayerGroupAll(), false);
    }
    else {
        DialogControlSetVisible(gv_episodeButtons[lp_index].lv_prcnt, PlayerGroupAll(), true);
        DialogControlSetVisible(gv_episodeButtons[lp_index].lv_cmp, PlayerGroupAll(), true);
    }
    if ((lp_index > gv_episodesUnlocked)) {
        DialogControlSetVisible(gv_episodeButtons[lp_index].lv_lbl, PlayerGroupAll(), false);
    }

}


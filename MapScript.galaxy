//--------------------------------------------------------------------------------------------------
// Trigger: Codex Change Category
//--------------------------------------------------------------------------------------------------
bool gt_CodexChangeCategory_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_n;

    // Automatic Variable Declarations
    const int autoBB8A669B_ae = 5;
    const int autoBB8A669B_ai = 1;
    const int autoF14F91B9_ae = 20;
    const int autoF14F91B9_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((gv_codex.lv_codexCategoryButtons[1] == EventDialogControl()) || (gv_codex.lv_codexCategoryButtons[2] == EventDialogControl()) || (gv_codex.lv_codexCategoryButtons[3] == EventDialogControl()) || (gv_codex.lv_codexCategoryButtons[4] == EventDialogControl()) || (gv_codex.lv_codexCategoryButtons[5] == EventDialogControl())))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogControlSetVisible(gv_codex.lv_unitIcon, PlayerGroupAll(), false);
    lv_n = 1;
    for ( ; ( (autoBB8A669B_ai >= 0 && lv_n <= autoBB8A669B_ae) || (autoBB8A669B_ai < 0 && lv_n >= autoBB8A669B_ae) ) ; lv_n += autoBB8A669B_ai ) {
        libNtve_gf_SetDialogItemToggled(gv_codex.lv_codexCategoryButtons[lv_n], false, PlayerGroupAll());
    }
    libNtve_gf_SetDialogItemUnitLink(gv_codex.lv_unitModel, "PathingBlocker1x1", PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_codex.lv_description, StringToText(""), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_codex.lv_header, StringToText(""), PlayerGroupAll());
    lv_n = 1;
    for ( ; ( (autoF14F91B9_ai >= 0 && lv_n <= autoF14F91B9_ae) || (autoF14F91B9_ai < 0 && lv_n >= autoF14F91B9_ae) ) ; lv_n += autoF14F91B9_ai ) {
        DialogControlDestroy(gv_codex.lv_codexButtons[lv_n]);
    }
    if ((gv_codex.lv_codexCategoryButtons[1] == EventDialogControl())) {
        TriggerExecute(gt_CodexTerranUnits, false, true);
        libNtve_gf_SetDialogItemText(gv_codex.lv_header, libAA0EBE8C_gv_sCMRLauncher.lv_codexTerran, PlayerGroupAll());
        libNtve_gf_SetDialogItemToggled(gv_codex.lv_codexCategoryButtons[1], true, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(libNtve_gf_ScreenImageDialogItem(20), "Assets\\Textures\\ui_battlenet_loading_player_racialicon_terran_l.dds", PlayerGroupAll());
        DialogControlSetSize(libNtve_gf_ScreenImageDialogItem(20), PlayerGroupAll(), 750, 640);
    }
    else {
        if ((gv_codex.lv_codexCategoryButtons[2] == EventDialogControl())) {
            TriggerExecute(gt_CodexZergUnits, false, true);
            libNtve_gf_SetDialogItemText(gv_codex.lv_header, libAA0EBE8C_gv_sCMRLauncher.lv_codexZerg, PlayerGroupAll());
            libNtve_gf_SetDialogItemToggled(gv_codex.lv_codexCategoryButtons[2], true, PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(libNtve_gf_ScreenImageDialogItem(20), "Assets\\Textures\\ui_battlenet_loading_player_racialicon_zerg_l.dds", PlayerGroupAll());
            DialogControlSetSize(libNtve_gf_ScreenImageDialogItem(20), PlayerGroupAll(), 750, 640);
        }
        else {
            if ((gv_codex.lv_codexCategoryButtons[3] == EventDialogControl())) {
                TriggerExecute(gt_CodexProtossUnits, false, true);
                libNtve_gf_SetDialogItemText(gv_codex.lv_header, libAA0EBE8C_gv_sCMRLauncher.lv_codexProtoss, PlayerGroupAll());
                libNtve_gf_SetDialogItemToggled(gv_codex.lv_codexCategoryButtons[3], true, PlayerGroupAll());
                libNtve_gf_SetDialogItemImage(libNtve_gf_ScreenImageDialogItem(20), "Assets\\Textures\\ui_battlenet_loading_player_racialicon_protoss_l.dds", PlayerGroupAll());
                DialogControlSetSize(libNtve_gf_ScreenImageDialogItem(20), PlayerGroupAll(), 750, 640);
            }
            else {
                if ((gv_codex.lv_codexCategoryButtons[4] == EventDialogControl())) {
                    TriggerExecute(gt_CodexCharacters, false, true);
                    libNtve_gf_SetDialogItemText(gv_codex.lv_header, libAA0EBE8C_gv_sCMRLauncher.lv_codexCharacters, PlayerGroupAll());
                    libNtve_gf_SetDialogItemToggled(gv_codex.lv_codexCategoryButtons[4], true, PlayerGroupAll());
                    libNtve_gf_SetDialogItemImage(libNtve_gf_ScreenImageDialogItem(20), "Assets\\Textures\\ui_loading_coop_tarsonistrain.dds", PlayerGroupAll());
                    DialogControlSetSize(libNtve_gf_ScreenImageDialogItem(20), PlayerGroupAll(), 750, 540);
                }
                else {
                    if ((gv_codex.lv_codexCategoryButtons[5] == EventDialogControl())) {
                        TriggerExecute(gt_CodexPlanets, false, true);
                        libNtve_gf_SetDialogItemText(gv_codex.lv_header, libAA0EBE8C_gv_sCMRLauncher.lv_codexPlanets, PlayerGroupAll());
                        libNtve_gf_SetDialogItemToggled(gv_codex.lv_codexCategoryButtons[5], true, PlayerGroupAll());
                        libNtve_gf_SetDialogItemImage(libNtve_gf_ScreenImageDialogItem(20), "Assets\\Textures\\loading-agria.dds", PlayerGroupAll());
                        DialogControlSetSize(libNtve_gf_ScreenImageDialogItem(20), PlayerGroupAll(), 750, 540);
                    }

                }
            }
        }
    }
    return true;
}


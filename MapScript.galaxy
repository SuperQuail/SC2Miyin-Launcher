//--------------------------------------------------------------------------------------------------
bool gt_LoadTestMap_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    GameSetNextMap("Starcraft Mass Recall/TEST");
    Wait(0.01, c_timeReal);
    DialogDestroyAll();
    GameOver(1, c_gameOverVictory, false, false);
    return true;
}


void gf_HideTitleScreen () {
    // Variable Declarations
    int lv_imageid;
    int lv_btnid;

    // Automatic Variable Declarations
    const int auto77C6B330_ae = 8;
    const int auto77C6B330_ai = 1;
    const int autoF29CFD90_ae = 8;
    const int autoF29CFD90_ai = 1;

    // Variable Initialization

    // Implementation
    lv_imageid = 0;
    for ( ; ( (auto77C6B330_ai >= 0 && lv_imageid <= auto77C6B330_ae) || (auto77C6B330_ai < 0 && lv_imageid >= auto77C6B330_ae) ) ; lv_imageid += auto77C6B330_ai ) {
        libNtve_gf_HideScreenImage(false, lv_imageid);
    }
    lv_btnid = 0;
    for ( ; ( (autoF29CFD90_ai >= 0 && lv_btnid <= autoF29CFD90_ae) || (autoF29CFD90_ai < 0 && lv_btnid >= autoF29CFD90_ae) ) ; lv_btnid += autoF29CFD90_ai ) {
        DialogControlSetVisible(gv_btnCampaign[lv_btnid], PlayerGroupAll(), false);
        DialogControlSetVisible(gv_btnLabels[lv_btnid], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnExtrasLabel, PlayerGroupAll(), false);
    DialogControlRemoveAllItems(gv_campaignselection, PlayerGroupAll());
    gf_HideEpisodeButton(false, 1);
    gf_HideEpisodeButton(false, 2);
    gf_HideEpisodeButton(false, 3);
    gf_HideEpisodeButton(false, 4);
    gf_HideEpisodeButton(false, 5);
    gf_HideEpisodeButton(false, 6);
    gf_HideEpisodeButton(false, 0);
    gf_HideEpisodeButton(false, 7);
    gf_HideEpisodeButton(false, 8);
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnContinue, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnOptions, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnExtras, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnStats, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnCredits, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnExit, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_mainMenuButtons.lv_btnCodex, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_version, PlayerGroupAll(), false);
}


bool gt_UnlockMapsPrompt_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_dialogOptions.lv_optBtnMapsUnlock == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogSetVisible(gv_optionsMenu, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optGameplayPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optVisualsPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optInterfacePanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optAudioPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optModelPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optRestorePanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optPuristPanel, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowLeft, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowRight, PlayerGroupAll(), false);
    DialogSetVisible(gv_mapUnlockPrompt, PlayerGroupAll(), true);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowSmallLeft, PlayerGroupAll(), true);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowSmallRight, PlayerGroupAll(), true);
    return true;
}


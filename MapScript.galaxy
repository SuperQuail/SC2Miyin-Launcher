    DialogControlSetSize(gv_missionselection, PlayerGroupAll(), 360, (350 + lv_addMissionListFrameCinema + lv_addMissionListFrameHiddenMaps));
    libNtve_gf_SetDialogItemText(gv_campaignHeader, libAA0EBE8C_gv_sCMRLauncher.lv_nameep1, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(gv_cmpRaceIcon, "Assets\\Textures\\ui_scr_glue_icon_terran_highlight.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(gv_campaignlistBG, "Assets\\Textures\\ui_scr_glues_pageassets_dialogbg.dds", PlayerGroupAll());

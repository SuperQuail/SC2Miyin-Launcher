//--------------------------------------------------------------------------------------------------
bool gt_ResetMaps_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_n;

    // Automatic Variable Declarations
    const int auto71D7A3BF_ae = 6;
    const int auto71D7A3BF_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((gv_dialogOptions.lv_optBtnMapsResetOK == EventDialogControl()) || (gv_dialogOptions.lv_optBtnMapsResetCancel == EventDialogControl())))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogSetVisible(gv_mapResetPrompt, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowSmallLeft, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowSmallRight, PlayerGroupAll(), false);
    if ((gv_dialogOptions.lv_optBtnMapsResetOK == EventDialogControl())) {
        BankSectionRemove(gv_sCMR, "CampaignProgress");
        BankSectionRemove(gv_sCMR, "stats");
        BankSectionRemove(gv_sCMR, "Codex");
        BankSectionRemove(gv_sCMR, "MapUnlocks");
        gv_statsLoaded = false;
        Wait(0.1, c_timeReal);
        lv_n = 1;
        for ( ; ( (auto71D7A3BF_ai >= 0 && lv_n <= auto71D7A3BF_ae) || (auto71D7A3BF_ai < 0 && lv_n >= auto71D7A3BF_ae) ) ; lv_n += auto71D7A3BF_ai ) {
            BankValueSetFromInt(gv_sCMR, "stats", ("Progress" + IntToString(lv_n)), 0);
            gv_stats.lv_progressPct[lv_n] = 0.0;
        }
        BankSave(gv_sCMR);
        Wait(0.1, c_timeReal);
        TriggerExecute(gt_backtomenu, false, true);
        TriggerExecute(gt_loadepcompleted, false, true);
        gf_ShowHideEpisodeCompletion(1);
        gf_ShowHideEpisodeCompletion(2);
        gf_ShowHideEpisodeCompletion(3);
        gf_ShowHideEpisodeCompletion(4);
        gf_ShowHideEpisodeCompletion(5);
        gf_ShowHideEpisodeCompletion(6);
        TriggerExecute(gt_setepisodeunlocks, false, true);
        gf_CreateCampaignList();
    }
    else {
        DialogControlSetVisible(gv_episodeButtons[1].lv_prcnt, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[2].lv_prcnt, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[3].lv_prcnt, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[4].lv_prcnt, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[5].lv_prcnt, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[6].lv_prcnt, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[1].lv_cmp, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[2].lv_cmp, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[3].lv_cmp, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[4].lv_cmp, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[5].lv_cmp, PlayerGroupAll(), false);
        DialogControlSetVisible(gv_episodeButtons[6].lv_cmp, PlayerGroupAll(), false);
        TriggerExecute(gt_OptionsMenu, false, false);
    }
    return true;
}


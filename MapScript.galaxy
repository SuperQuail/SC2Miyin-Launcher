        BankValueSetFromFlag(gv_sCMR, "models", "CitadelOfAdun", false);
        BankValueSetFromFlag(gv_sCMR, "models", "Stargate", false);
        BankValueSetFromFlag(gv_sCMR, "models", "RoboticsFacility", false);
        BankValueSetFromFlag(gv_sCMR, "models", "FleetBeacon", false);
        BankWait(gv_sCMR);
        BankSave(gv_sCMR);
    }
    return true;
}


//--------------------------------------------------------------------------------------------------
bool gt_EndingCreditsfinish_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerStop(gt_EndingCredits);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeCreditsPanel, false);
    TriggerExecute(gt_backtomenu, false, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EndingCreditsfinish_Init () {
    gt_EndingCreditsfinish = TriggerCreate("gt_EndingCreditsfinish_Func");
    TriggerEnable(gt_EndingCreditsfinish, false);
    TriggerAddEventGameCreditsFinished(gt_EndingCreditsfinish, c_playerAny);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Ending - Credits close
//--------------------------------------------------------------------------------------------------
bool gt_EndingCreditsclose_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_creditsBtnOk == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_EndingCreditsfinish, false);
    TriggerStop(gt_EndingCredits);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeCreditsPanel, false);
    TriggerExecute(gt_backtomenu, false, false);
    return true;
}


//--------------------------------------------------------------------------------------------------
// Trigger: Cancel Options
//--------------------------------------------------------------------------------------------------
bool gt_CancelOptions_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_dialogOptions.lv_optBtnCancel == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_LoadOptions();
    gf_LoadSounds();
    gf_LoadModels();
    gf_MenuBackground(gv_menuBackground);
    TriggerExecute(gt_backtomenu, false, false);
    return true;
}


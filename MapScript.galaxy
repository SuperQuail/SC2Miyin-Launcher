    libNtve_gf_SetDialogItemImage(gv_cmpGlowBottom, "Assets\\Textures\\ui_scr_glues_pageassets_dialog_hexpattern.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(gv_cmpGlowLeft, "Assets\\Textures\\ui_scr_glues_pageassets_dialogbg_glow.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(gv_cmpGlowRight, "Assets\\Textures\\ui_scr_glues_pageassets_dialogbg_glow.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(gv_campaignselection, "Assets\\Textures\\ui_scr_glues_pageassets_maincontainer.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(gv_missionselection, "Assets\\Textures\\ui_scr_glues_pageassets_maincontainer.dds", PlayerGroupAll());
    TriggerExecute(gt_Ep1maplist, false, true);
    gv_selectedCampaign = 1;
    gv_campaign = "1. Rebel Yell/";
    gv_mission[1] = "starintr";
    gv_mission[2] = "Terran00t";
    gv_mission[3] = "Terran01";
    gv_mission[4] = "Terran02";
    gv_mission[5] = "terran1";
    gv_mission[6] = "Terran03";
    gv_mission[7] = "Terran04";
    gv_mission[8] = "Terran05";
    gv_mission[9] = "terran2";
    gv_mission[10] = "Terran06";
    gv_mission[11] = "Terran07";
    lv_n = 12;
    if ((gv_mapUnlocks.lv_ep1ExtraMaps == true)) {
        gv_mission[12] = "Terran07S";
        lv_n = (lv_n + 1);
    }

    gv_mission[lv_n] = "Terran08";
    lv_n = (lv_n + 1);
    gv_mission[lv_n] = "terran3";
    lv_n = (lv_n + 1);
    if ((gv_mapUnlocks.lv_ep1ExtraMaps == true)) {
        gv_mission[lv_n] = "Terran08S";
        lv_n = (lv_n + 1);
    }

    if ((BankValueGetAsFlag(gv_sCMR, "options", "NewGettysburgCity") == true)) {

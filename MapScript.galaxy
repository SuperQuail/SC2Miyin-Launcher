    DialogControlSetVisible(gv_dialogOptions.lv_optGlowSmallRight, PlayerGroupAll(), true);
    DialogSetRenderPriority(gv_firstTimeSCMR, 900);
    BankReload(gv_sCMR);
    BankWait(gv_sCMR);
    BankValueSetFromFlag(gv_sCMR, "FirstTimePopups", "AudioSetup", false);
    BankSave(gv_sCMR);
    return true;
}


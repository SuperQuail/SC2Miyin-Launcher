//--------------------------------------------------------------------------------------------------
bool gt_CodexSelectUnits_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_n;

    // Automatic Variable Declarations
    const int auto1B3FC751_ae = 20;
    const int auto1B3FC751_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((DialogControlGetType(EventDialogControl()) == c_triggerControlTypeButton))) {
            return false;
        }

        if (!((gv_codex.lv_codexCategoryButtons[1] != EventDialogControl()))) {
            return false;
        }

        if (!((gv_codex.lv_codexCategoryButtons[2] != EventDialogControl()))) {
            return false;
        }

        if (!((gv_codex.lv_codexCategoryButtons[3] != EventDialogControl()))) {
            return false;
        }

        if (!((gv_codex.lv_codexCategoryButtons[4] != EventDialogControl()))) {
            return false;
        }

        if (!((gv_codex.lv_codexCategoryButtons[5] != EventDialogControl()))) {
            return false;
        }

        if (!((gv_codexBtnOk != EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_n = 1;
    for ( ; ( (auto1B3FC751_ai >= 0 && lv_n <= auto1B3FC751_ae) || (auto1B3FC751_ai < 0 && lv_n >= auto1B3FC751_ae) ) ; lv_n += auto1B3FC751_ai ) {
        if ((gv_codex.lv_codexButtons[lv_n] == EventDialogControl())) {
            if ((BankValueGetAsFlag(gv_sCMR, "models", libNtve_gf_DialogItemEditValue(EventDialogControl(), 1)) == false)) {
                gf_CodexUnitProfile(libNtve_gf_DialogItemEditValue(EventDialogControl(), 1), gv_codexUnitIcons[1][lv_n]);
            }
            else {
                gf_CodexUnitProfile(libNtve_gf_DialogItemEditValue(EventDialogControl(), 1), gv_codexUnitIcons[2][lv_n]);
            }
        }
        else {
            libNtve_gf_SetDialogItemToggled(gv_codex.lv_codexButtons[lv_n], false, PlayerGroupAll());
        }
    }
    libNtve_gf_SetDialogItemToggled(EventDialogControl(), true, PlayerGroupAll());
    return true;
}


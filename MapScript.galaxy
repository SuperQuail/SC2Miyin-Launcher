//--------------------------------------------------------------------------------------------------
// Trigger: VideoStart
//--------------------------------------------------------------------------------------------------
bool gt_VideoStart_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UISetWorldVisible(PlayerGroupAll(), false);
    CutsceneFade(true, 1.0, Color(0,0,0), 100.0, PlayerGroupAll(), true);
    lib9770F675_gv_iniNextCinematicLink = gv_mission[DialogControlGetSelectedItem(gv_missionselection, 1)];
    gf_PreVideoText();
    DialogSetVisible(gv_background, PlayerGroupAll(), false);
    DialogSetVisible(gv_campaignlist, PlayerGroupAll(), false);
    DialogSetVisible(gv_logo, PlayerGroupAll(), false);
    libNtve_gf_HideScreenImage(false, (gv_selectedCampaign + 10));
    DialogSetVisible(gv_missionlist, PlayerGroupAll(), false);
    DialogSetVisible(gv_version, PlayerGroupAll(), false);
    GameSetLighting("Cinema", 0.0);
    lib9770F675_gf_Cinematic();
    if ((gv_beginningCampaign == true)) {
        GameOver(1, c_gameOverVictory, false, false);
    }
    else {
        GameSetLighting("SCMRold", 0.0);
        gf_MenuBackground(gv_menuBackground);
        UISetWorldVisible(PlayerGroupAll(), true);
        CameraLockInput(1, true);
        DialogSetVisible(gv_background, PlayerGroupAll(), true);
        DialogSetVisible(gv_campaignlist, PlayerGroupAll(), true);
        DialogSetVisible(gv_logo, PlayerGroupAll(), true);
        libNtve_gf_HideScreenImage(true, (gv_selectedCampaign + 10));
        DialogSetVisible(gv_missionlist, PlayerGroupAll(), true);
        CutsceneFade(true, 0.0, Color(0,0,0), 100.0, PlayerGroupAll(), true);
    }
    return true;
}


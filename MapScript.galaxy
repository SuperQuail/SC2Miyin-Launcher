//--------------------------------------------------------------------------------------------------
// Trigger: set episode unlocks
//--------------------------------------------------------------------------------------------------
bool gt_setepisodeunlocks_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_n;

    // Automatic Variable Declarations
    const int auto23B3BBC2_ae = 6;
    const int auto23B3BBC2_ai = 1;
    const int auto1F265A27_ae = 6;
    const int auto1F265A27_ai = 1;
    const int auto4546CDE6_ae = 6;
    const int auto4546CDE6_ai = 1;
    const int auto522009C0_ae = 6;
    const int auto522009C0_ai = 1;
    const int auto3EE5FCC0_ae = 6;
    const int auto3EE5FCC0_ai = 1;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((BankValueGetAsFlag(gv_sCMR, "options", "UnlockCampaigns") == true)) {
        gv_episodesUnlocked = 6;
        lv_n = 2;
        for ( ; ( (auto23B3BBC2_ai >= 0 && lv_n <= auto23B3BBC2_ae) || (auto23B3BBC2_ai < 0 && lv_n >= auto23B3BBC2_ae) ) ; lv_n += auto23B3BBC2_ai ) {
            libNtve_gf_SetDialogItemDesaturated(gv_btnCampaign[lv_n], false, PlayerGroupAll());
            libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_img, false, PlayerGroupAll());
            libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_epimg, false, PlayerGroupAll());
            libNtve_gf_SetDialogItemAcceptMouse(gv_btnCampaign[lv_n], true, PlayerGroupAll());
            DialogControlSetVisible(gv_episodeButtons[lv_n].lv_lbl, PlayerGroupAll(), true);
            DialogControlSetEnabled(gv_btnCampaign[lv_n], PlayerGroupAll(), true);
        }
    }
    else {
        if ((gv_episodeCompleted[1] < 100)) {
            gv_episodesUnlocked = 1;
            lv_n = 2;
            for ( ; ( (auto3EE5FCC0_ai >= 0 && lv_n <= auto3EE5FCC0_ae) || (auto3EE5FCC0_ai < 0 && lv_n >= auto3EE5FCC0_ae) ) ; lv_n += auto3EE5FCC0_ai ) {
                libNtve_gf_SetDialogItemDesaturated(gv_btnCampaign[lv_n], true, PlayerGroupAll());
                libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_img, true, PlayerGroupAll());
                libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_epimg, true, PlayerGroupAll());
                libNtve_gf_SetDialogItemAcceptMouse(gv_btnCampaign[lv_n], false, PlayerGroupAll());
                DialogControlSetVisible(gv_episodeButtons[lv_n].lv_lbl, PlayerGroupAll(), false);
                DialogControlSetEnabled(gv_btnCampaign[lv_n], PlayerGroupAll(), false);
            }
        }
        else {
            if ((gv_episodeCompleted[2] < 100)) {
                gv_episodesUnlocked = 2;
                lv_n = 3;
                for ( ; ( (auto522009C0_ai >= 0 && lv_n <= auto522009C0_ae) || (auto522009C0_ai < 0 && lv_n >= auto522009C0_ae) ) ; lv_n += auto522009C0_ai ) {
                    libNtve_gf_SetDialogItemDesaturated(gv_btnCampaign[lv_n], true, PlayerGroupAll());
                    libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_img, true, PlayerGroupAll());
                    libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_epimg, true, PlayerGroupAll());
                    libNtve_gf_SetDialogItemAcceptMouse(gv_btnCampaign[lv_n], false, PlayerGroupAll());
                    DialogControlSetVisible(gv_episodeButtons[lv_n].lv_lbl, PlayerGroupAll(), false);
                    DialogControlSetEnabled(gv_btnCampaign[lv_n], PlayerGroupAll(), false);
                }
            }
            else {
                if ((gv_episodeCompleted[3] < 100)) {
                    gv_episodesUnlocked = 3;
                    lv_n = 4;
                    for ( ; ( (auto4546CDE6_ai >= 0 && lv_n <= auto4546CDE6_ae) || (auto4546CDE6_ai < 0 && lv_n >= auto4546CDE6_ae) ) ; lv_n += auto4546CDE6_ai ) {
                        libNtve_gf_SetDialogItemDesaturated(gv_btnCampaign[lv_n], true, PlayerGroupAll());
                        libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_img, true, PlayerGroupAll());
                        libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_epimg, true, PlayerGroupAll());
                        libNtve_gf_SetDialogItemAcceptMouse(gv_btnCampaign[lv_n], false, PlayerGroupAll());
                        DialogControlSetVisible(gv_episodeButtons[lv_n].lv_lbl, PlayerGroupAll(), false);
                        DialogControlSetEnabled(gv_btnCampaign[lv_n], PlayerGroupAll(), false);
                    }
                }
                else {
                    if ((gv_episodeCompleted[4] < 100)) {
                        gv_episodesUnlocked = 4;
                        lv_n = 5;
                        for ( ; ( (auto1F265A27_ai >= 0 && lv_n <= auto1F265A27_ae) || (auto1F265A27_ai < 0 && lv_n >= auto1F265A27_ae) ) ; lv_n += auto1F265A27_ai ) {
                            libNtve_gf_SetDialogItemDesaturated(gv_btnCampaign[lv_n], true, PlayerGroupAll());
                            libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_img, true, PlayerGroupAll());
                            libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_epimg, true, PlayerGroupAll());
                            libNtve_gf_SetDialogItemAcceptMouse(gv_btnCampaign[lv_n], false, PlayerGroupAll());
                            DialogControlSetVisible(gv_episodeButtons[lv_n].lv_lbl, PlayerGroupAll(), false);
                            DialogControlSetEnabled(gv_btnCampaign[lv_n], PlayerGroupAll(), false);
                        }
                    }
                    else {
                        if ((gv_episodeCompleted[5] < 100)) {
                            gv_episodesUnlocked = 5;
                            libNtve_gf_SetDialogItemDesaturated(gv_btnCampaign[6], true, PlayerGroupAll());
                            libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_img, true, PlayerGroupAll());
                            libNtve_gf_SetDialogItemDesaturated(gv_episodeButtons[lv_n].lv_epimg, true, PlayerGroupAll());
                            libNtve_gf_SetDialogItemAcceptMouse(gv_btnCampaign[lv_n], false, PlayerGroupAll());
                            DialogControlSetVisible(gv_episodeButtons[lv_n].lv_lbl, PlayerGroupAll(), false);
                            DialogControlSetEnabled(gv_btnCampaign[6], PlayerGroupAll(), false);
                        }
                        else {
                            gv_episodesUnlocked = 6;
                        }
                    }
                }
            }
        }
    }
    return true;
}


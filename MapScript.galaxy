//--------------------------------------------------------------------------------------------------
// Trigger: Menu Buttons
//--------------------------------------------------------------------------------------------------
bool gt_MenuButtons_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_imageid;
    int lv_btnid;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((gv_mainMenuButtons.lv_btnCredits == EventDialogControl()) || (gv_mainMenuButtons.lv_btnStats == EventDialogControl()) || (gv_mainMenuButtons.lv_btnOptions == EventDialogControl()) || (gv_mainMenuButtons.lv_btnExit == EventDialogControl()) || (gv_mainMenuButtons.lv_btnCodex == EventDialogControl())))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_HideTitleScreen();
    if ((gv_mainMenuButtons.lv_btnExit == EventDialogControl())) {
        TriggerExecute(gt_Exit, false, false);
    }
    else {
        if ((gv_mainMenuButtons.lv_btnCredits == EventDialogControl())) {
            TriggerExecute(gt_EndingCredits, false, false);
        }
        else {
            if ((gv_mainMenuButtons.lv_btnStats == EventDialogControl())) {
                TriggerExecute(gt_Stats, false, false);
            }
            else {
                if ((gv_mainMenuButtons.lv_btnOptions == EventDialogControl())) {
                    TriggerExecute(gt_OptionsMenu, false, false);
                }
                else {
                    if ((gv_mainMenuButtons.lv_btnCodex == EventDialogControl())) {
                        TriggerExecute(gt_Codex, false, false);
                    }

                }
            }
        }
    }
    DialogSetImageVisible(gv_background, false);
    DialogControlSetVisible(gv_backgroundImage, PlayerGroupAll(), false);
    Wait(0.05, c_timeReal);
    DialogSetImageVisible(gv_background, false);
    DialogControlSetVisible(gv_backgroundImage, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_campaignHeader, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_campaignHeader2, PlayerGroupAll(), false);
    Wait(0.05, c_timeReal);
    DialogSetImageVisible(gv_background, false);
    DialogControlSetVisible(gv_backgroundImage, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_campaignHeader, PlayerGroupAll(), false);
    DialogControlSetVisible(gv_campaignHeader2, PlayerGroupAll(), false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MenuButtons_Init () {
    gt_MenuButtons = TriggerCreate("gt_MenuButtons_Func");
    TriggerAddEventDialogControl(gt_MenuButtons, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Options Menu
//--------------------------------------------------------------------------------------------------
bool gt_OptionsMenu_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnGameplay, true, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnInterface, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnVisuals, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnAudio, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnAudioVO, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnModel, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnEvoChamber, false, PlayerGroupAll());
    DialogSetVisible(gv_optionsMenu, PlayerGroupAll(), true);
    DialogSetVisible(gv_dialogOptions.lv_optGameplayPanel, PlayerGroupAll(), true);
    DialogSetVisible(gv_dialogOptions.lv_optRestorePanel, PlayerGroupAll(), true);
    DialogSetVisible(gv_dialogOptions.lv_optPuristPanel, PlayerGroupAll(), true);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowLeft, PlayerGroupAll(), true);
    DialogControlSetVisible(gv_dialogOptions.lv_optGlowRight, PlayerGroupAll(), true);
    gv_optionsMenuActive = true;
    gf_LoadOptions();
    gf_LoadSounds();
    gf_LoadModels();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_OptionsMenu_Init () {
    gt_OptionsMenu = TriggerCreate("gt_OptionsMenu_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Options Menu Tabs
//--------------------------------------------------------------------------------------------------
bool gt_OptionsMenuTabs_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((gv_dialogOptions.lv_btnGameplay == EventDialogControl()) || (gv_dialogOptions.lv_btnInterface == EventDialogControl()) || (gv_dialogOptions.lv_btnVisuals == EventDialogControl()) || (gv_dialogOptions.lv_btnAudio == EventDialogControl()) || (gv_dialogOptions.lv_btnAudioVO == EventDialogControl()) || (gv_dialogOptions.lv_btnModel == EventDialogControl()) || (gv_dialogOptions.lv_btnEvoChamber == EventDialogControl())))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnGameplay, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnVisuals, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnInterface, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnAudio, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnAudioVO, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnModel, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnEvoChamber, false, PlayerGroupAll());
    DialogSetVisible(gv_dialogOptions.lv_optGameplayPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optInterfacePanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optVisualsPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optAudioPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optAudioVOPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optModelPanel, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogOptions.lv_optEvoChamberPanel, PlayerGroupAll(), false);
    if ((gv_dialogOptions.lv_btnGameplay == EventDialogControl())) {
        libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnGameplay, true, PlayerGroupAll());
        DialogSetVisible(gv_dialogOptions.lv_optGameplayPanel, PlayerGroupAll(), true);
    }
    else {
        if ((gv_dialogOptions.lv_btnInterface == EventDialogControl())) {
            libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnInterface, true, PlayerGroupAll());
            DialogSetVisible(gv_dialogOptions.lv_optInterfacePanel, PlayerGroupAll(), true);
        }
        else {
            if ((gv_dialogOptions.lv_btnVisuals == EventDialogControl())) {
                libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnVisuals, true, PlayerGroupAll());
                DialogSetVisible(gv_dialogOptions.lv_optVisualsPanel, PlayerGroupAll(), true);
            }
            else {
                if ((gv_dialogOptions.lv_btnAudio == EventDialogControl())) {
                    libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnAudio, true, PlayerGroupAll());
                    DialogSetVisible(gv_dialogOptions.lv_optAudioPanel, PlayerGroupAll(), true);
                }
                else {
                    if ((gv_dialogOptions.lv_btnAudioVO == EventDialogControl())) {
                        libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnAudioVO, true, PlayerGroupAll());
                        DialogSetVisible(gv_dialogOptions.lv_optAudioVOPanel, PlayerGroupAll(), true);
                    }
                    else {
                        if ((gv_dialogOptions.lv_btnModel == EventDialogControl())) {
                            libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnModel, true, PlayerGroupAll());
                            DialogSetVisible(gv_dialogOptions.lv_optModelPanel, PlayerGroupAll(), true);
                        }
                        else {
                            if ((gv_dialogOptions.lv_btnEvoChamber == EventDialogControl())) {
                                libNtve_gf_SetDialogItemToggled(gv_dialogOptions.lv_btnEvoChamber, true, PlayerGroupAll());
                                DialogSetVisible(gv_dialogOptions.lv_optEvoChamberPanel, PlayerGroupAll(), true);
                            }

                        }
                    }
                }
            }
        }
    }
    return true;
}


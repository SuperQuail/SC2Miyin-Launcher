//--------------------------------------------------------------------------------------------------
// Trigger: EpisodeButtonClicked
//--------------------------------------------------------------------------------------------------
bool gt_EpisodeButtonClicked_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    const int autoF97CA683_ae = gv_episodeButtonMaxCount;
    const int autoF97CA683_ai = 1;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_index = 0;
    for ( ; ( (autoF97CA683_ai >= 0 && lv_index <= autoF97CA683_ae) || (autoF97CA683_ai < 0 && lv_index >= autoF97CA683_ae) ) ; lv_index += autoF97CA683_ai ) {
        if ((EventDialogControl() == gv_episodeButtons[lv_index].lv_btn)) {
            TriggerExecute(libNtve_gv_screenButtonCallbacks[lv_index], true, false);
            DialogControlFadeTransparency(gv_episodeButtons[lv_index].lv_imgbtm, PlayerGroupAll(), 0.01, 10.0);
            DialogControlFadeTransparency(gv_episodeButtons[lv_index].lv_imgtop, PlayerGroupAll(), 0.01, 10.0);
            libNtve_gf_SetDialogItemImage(gv_episodeButtons[lv_index].lv_img, gv_episodeButtonsClickedImage, PlayerGroupAll());
            Wait(0.001, c_timeReal);
            libNtve_gf_SetDialogItemImage(gv_episodeButtons[lv_index].lv_img, gv_episodeButtonsHoverImage, PlayerGroupAll());
            Wait(0.05, c_timeReal);
            DialogControlFadeTransparency(gv_episodeButtons[lv_index].lv_imgbtm, PlayerGroupAll(), 0.0, 100.0);
            DialogControlFadeTransparency(gv_episodeButtons[lv_index].lv_imgtop, PlayerGroupAll(), 0.0, 100.0);
            libNtve_gf_SetDialogItemImage(gv_episodeButtons[lv_index].lv_img, gv_episodeButtonsImage, PlayerGroupAll());
            return true;
        }

    }
    return true;
}


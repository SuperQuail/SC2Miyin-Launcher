void gt_OptionsPsiEmitters_Init () {
    gt_OptionsPsiEmitters = TriggerCreate("gt_OptionsPsiEmitters_Func");
    TriggerAddEventDialogControl(gt_OptionsPsiEmitters, 1, c_invalidDialogControlId, c_triggerControlEventTypeChecked);
}


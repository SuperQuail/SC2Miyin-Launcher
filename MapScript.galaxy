//--------------------------------------------------------------------------------------------------
// Trigger: Change Menu Background
//--------------------------------------------------------------------------------------------------
bool gt_ChangeMenuBackground_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_dialogOptions.lv_optBackground == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_MenuBackground(DialogControlGetSelectedItem(EventDialogControl(), 1));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ChangeMenuBackground_Init () {
    gt_ChangeMenuBackground = TriggerCreate("gt_ChangeMenuBackground_Func");
    TriggerAddEventDialogControl(gt_ChangeMenuBackground, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeSelectionChanged);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Menu Background Cam Birdseye
//--------------------------------------------------------------------------------------------------
bool gt_MenuBackgroundCamBirdseye_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        CameraApplyInfo(1, CameraInfoFromId(902633313), 52.0, 80.0, 0.0, true);
        Wait(48.0, c_timeReal);
        CameraApplyInfo(1, CameraInfoFromId(935684188), 52.0, 80.0, 0.0, true);
        Wait(48.0, c_timeReal);
        CameraApplyInfo(1, CameraInfoFromId(807488108), 28.0, 80.0, 0.0, true);
        Wait(25.0, c_timeReal);
        CameraApplyInfo(1, CameraInfoFromId(14), 35.0, 80.0, 0.0, true);
        Wait(32.0, c_timeReal);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MenuBackgroundCamBirdseye_Init () {
    gt_MenuBackgroundCamBirdseye = TriggerCreate("gt_MenuBackgroundCamBirdseye_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Menu Background Cam City
//--------------------------------------------------------------------------------------------------
bool gt_MenuBackgroundCamCity_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_panTime;
    fixed lv_waitTime;
    fixed lv_velocity;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_panTime = 180.0;
    lv_waitTime = 180.0;
    lv_velocity = 100.0;

    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        CameraApplyInfo(1, CameraInfoFromId(700832945), lv_panTime, lv_velocity, 0.0, true);
        Wait(lv_waitTime, c_timeReal);
        CameraApplyInfo(1, CameraInfoFromId(651129029), lv_panTime, lv_velocity, 0.0, true);
        Wait(lv_waitTime, c_timeReal);
        CameraApplyInfo(1, CameraInfoFromId(918513714), 225.0, lv_velocity, 0.0, true);
        Wait(225.0, c_timeReal);
        CameraApplyInfo(1, CameraInfoFromId(1934098026), lv_panTime, lv_velocity, 0.0, true);
        Wait(lv_waitTime, c_timeReal);
        CameraApplyInfo(1, CameraInfoFromId(815960109), lv_panTime, lv_velocity, 0.0, true);
        Wait(lv_waitTime, c_timeReal);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MenuBackgroundCamCity_Init () {
    gt_MenuBackgroundCamCity = TriggerCreate("gt_MenuBackgroundCamCity_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Menu Background Light Trip
//--------------------------------------------------------------------------------------------------
bool gt_MenuBackgroundLightTrip_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_currentLight;
    int lv_randomizer;
    string[5] lv_light;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_currentLight = 1;
    lv_randomizer = 1;

    // Actions
    if (!runActions) {
        return true;
    }

    lv_light[1] = "SCMR";
    lv_light[2] = "SCMRCity";
    lv_light[3] = "SCMRDark";
    lv_light[4] = "SCMRDawn";
    lv_randomizer = RandomInt(1, 4);
    while (true) {
        while ((lv_randomizer == lv_currentLight)) {
            lv_randomizer = RandomInt(1, 4);
        }
        GameSetLighting(lv_light[lv_randomizer], 60.0);
        lv_currentLight = lv_randomizer;
        Wait(60.0, c_timeReal);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MenuBackgroundLightTrip_Init () {
    gt_MenuBackgroundLightTrip = TriggerCreate("gt_MenuBackgroundLightTrip_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Load Bank
//--------------------------------------------------------------------------------------------------
bool gt_LoadBank_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    DialogControlDestroy(gv_btnContinue);
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll());
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optEffectsWeather, PlayerGroupAll());
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll());
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll());
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optMusic, PlayerGroupAll());
    DialogControlRemoveAllItems(gv_dialogOptions.lv_optCommandBars, PlayerGroupAll());
    if ((CatalogFieldValueGetAsInt(c_gameCatalogUnit, "CommentatorBot1", "LifeMax", 1) != 5)) {
        gv_iniCinematicsMod = true;
    }

    Wait(0.1, c_timeReal);
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "Title", c_soundtrackCueAny, c_soundtrackIndexAny, true);
    DialogControlAddItem(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedSlower);
    DialogControlAddItem(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedSlow);
    DialogControlAddItem(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedNormal);
    DialogControlAddItem(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedFast);
    DialogControlAddItem(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedFaster);
    if ((gv_iniCinematicsMod == true)) {
        DialogControlAddItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optInterludesSCR);
    }

    DialogControlAddItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optInterludesSCBW);
    DialogControlAddItem(gv_dialogOptions.lv_optInterstitials, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optInterludesSCMR);
    DialogControlAddItem(gv_dialogOptions.lv_optEffectsWeather, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optWeather0);
    DialogControlAddItem(gv_dialogOptions.lv_optEffectsWeather, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optWeather1);
    DialogControlAddItem(gv_dialogOptions.lv_optEffectsWeather, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optWeather2);
    DialogControlAddItem(gv_dialogOptions.lv_optEffectsWeather, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optWeather3);
    DialogControlAddItem(gv_dialogOptions.lv_optMusic, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optMusicBW);
    DialogControlAddItem(gv_dialogOptions.lv_optMusic, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optMusicSC2);
    DialogControlAddItem(gv_dialogOptions.lv_optMusic, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optMusicBoth);
    DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyEasy);
    DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyNormal);
    DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyHard);
    DialogControlAddItem(gv_dialogOptions.lv_optCommandBars, PlayerGroupAll(), gv_optBarDefault);
    DialogControlAddItem(gv_dialogOptions.lv_optCommandBars, PlayerGroupAll(), gv_optBarClassic);
    DialogControlAddItem(gv_dialogOptions.lv_optCommandBars, PlayerGroupAll(), gv_optBarFaction);
    if ((gv_insaneDifficultyUnlocked == true)) {
        DialogControlAddItem(gv_dialogOptions.lv_optDifficulty, PlayerGroupAll(), libAA0EBE8C_gv_sCMRLauncher.lv_optDifficultyInsane);
    }

    BankLoad("SCMR", 1);
    gv_sCMR = BankLastCreated();
    Wait(0.1, c_timeReal);
    BankReload(gv_sCMR);
    BankWait(gv_sCMR);
    if ((BankSectionExists(BankLastCreated(), "options") == true)) {
        gv_menuBackgroundRandom = BankValueGetAsFlag(gv_sCMR, "options", "MenuBackgroundRandom");
        gv_mapUnlocks.lv_ep1ExtraMaps = BankValueGetAsFlag(gv_sCMR, "options", "HiddenMaps");
        gv_mapUnlocks.lv_tX05a = BankValueGetAsFlag(gv_sCMR, "MapUnlocks", "TX05a");
        gv_mapUnlocks.lv_tX05b = BankValueGetAsFlag(gv_sCMR, "MapUnlocks", "TX05b");
        gv_mapUnlocks.lv_zX09S = BankValueGetAsFlag(gv_sCMR, "MapUnlocks", "ZX09S");
        if ((gv_menuBackgroundRandom == false)) {
            gv_menuBackground = BankValueGetAsInt(gv_sCMR, "options", "MenuBackground");
            gf_MenuBackground(gv_menuBackground);
        }
        else {
            gv_menuBackground = RandomInt(1, 9);
            gf_MenuBackground(gv_menuBackground);
        }
        if ((BankValueGetAsFixed(gv_sCMR, "version", "version") < 8.0)) {
            BankValueSetFromFixed(gv_sCMR, "version", "version", 8.0);
            BankValueSetFromFlag(gv_sCMR, "FirstTimePopups", "PsiEmitters", true);
            BankValueSetFromFlag(gv_sCMR, "options", "PsiEmitters", false);
            BankValueSetFromFlag(gv_sCMR, "options", "EffectsFires", true);
            BankValueSetFromFlag(gv_sCMR, "options", "InstallationCamZoom", true);
            BankValueSetFromFlag(gv_sCMR, "options", "HideKillsWhenZero", false);
            BankValueSetFromFlag(gv_sCMR, "options", "UnlockCampaigns", true);
            BankValueSetFromFlag(gv_sCMR, "options", "ExtraDialogue", true);
            if ((gv_iniCinematicsMod == true)) {
                BankValueSetFromInt(gv_sCMR, "options", "InterstitialsNew", 1);
            }
            else {
                BankValueSetFromInt(gv_sCMR, "options", "InterstitialsNew", 2);
            }
            if ((BankValueGetAsInt(gv_sCMR, "options", "difficulty") == 4)) {
                BankValueSetFromInt(gv_sCMR, "options", "difficulty", 3);
            }

        }

        if ((BankValueGetAsFlag(gv_sCMR, "FirstTimePopups", "AudioSetup") == true)) {
            TriggerEnable(gt_FirstTimeAudioSetup, true);
        }

        if ((BankValueGetAsFlag(gv_sCMR, "FirstTimePopups", "ModelSetup") == true)) {
            TriggerEnable(gt_FirstTimeModelSetup, true);
        }

        if ((BankValueGetAsFlag(gv_sCMR, "FirstTimePopups", "Codex") == true)) {
            TriggerEnable(gt_FirstTimeCodex, true);
        }

        if ((BankValueGetAsFlag(gv_sCMR, "FirstTimePopups", "EvoChamberSetup") == true)) {
            TriggerEnable(gt_FirstTimeEvoChamberSetup, true);
        }

        if ((BankValueGetAsFlag(gv_sCMR, "FirstTimePopups", "Extras") == true)) {
            TriggerEnable(gt_FirstTimeExtrasPopup, true);
        }

        if ((BankValueGetAsFlag(gv_sCMR, "FirstTimePopups", "PsiEmitters") == true)) {
            TriggerEnable(gt_FirstTimeBrutalDifficultyPopup, true);
        }

        gf_LoadStats();
        gf_LoadStatsOverall();
        if ((gv_iniCinematicsMod == false) && ((BankValueGetAsFlag(gv_sCMR, "options", "Cinematics") == true))) {
            BankValueSetFromFlag(gv_sCMR, "options", "Cinematics", false);
            BankWait(gv_sCMR);
            BankSave(gv_sCMR);
        }

    }
    else {
        TriggerEnable(gt_SCMRFirstRun, true);
        BankValueSetFromFixed(gv_sCMR, "version", "version", 8.0);
        BankValueSetFromInt(gv_sCMR, "stats", "Progress1", 0);
        BankValueSetFromInt(gv_sCMR, "stats", "Progress2", 0);
        BankValueSetFromInt(gv_sCMR, "stats", "Progress3", 0);
        BankValueSetFromInt(gv_sCMR, "stats", "Progress4", 0);
        BankValueSetFromInt(gv_sCMR, "stats", "Progress5", 0);
        BankValueSetFromInt(gv_sCMR, "stats", "Progress6", 0);
        BankValueSetFromInt(gv_sCMR, "options", "gamespeed", 5);
        BankValueSetFromInt(gv_sCMR, "options", "difficulty", 2);
        BankValueSetFromInt(gv_sCMR, "options", "console", 1);
        BankValueSetFromInt(gv_sCMR, "options", "music", 1);
        BankValueSetFromInt(gv_sCMR, "options", "MenuBackground", 1);
        BankValueSetFromFlag(gv_sCMR, "FirstTimePopups", "AudioSetup", true);
        BankValueSetFromFlag(gv_sCMR, "FirstTimePopups", "ModelSetup", true);
        BankValueSetFromFlag(gv_sCMR, "FirstTimePopups", "Codex", true);
        BankValueSetFromFlag(gv_sCMR, "FirstTimePopups", "EvoChamberSetup", true);
        BankValueSetFromFlag(gv_sCMR, "FirstTimePopups", "PsiEmitters", true);
        BankValueSetFromFlag(gv_sCMR, "options", "MenuBackgroundRandom", false);
        BankValueSetFromFlag(gv_sCMR, "options", "BWtech", true);
        BankValueSetFromFlag(gv_sCMR, "options", "HeroStatusBar", true);
        BankValueSetFromFlag(gv_sCMR, "options", "HiddenMaps", true);
        BankValueSetFromFlag(gv_sCMR, "options", "TPSmode", false);
        BankValueSetFromFlag(gv_sCMR, "options", "InstallationCamZoom", true);
        BankValueSetFromFlag(gv_sCMR, "options", "Autosave", false);
        BankValueSetFromFlag(gv_sCMR, "options", "SOKModels", false);
        BankValueSetFromFlag(gv_sCMR, "options", "UEDModels", false);
        BankValueSetFromFlag(gv_sCMR, "options", "OvermindModels", false);
        BankValueSetFromFlag(gv_sCMR, "options", "CerebrateModels", false);

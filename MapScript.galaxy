//--------------------------------------------------------------------------------------------------
// Trigger: GameSpeedChangedValue
//--------------------------------------------------------------------------------------------------
bool gt_GameSpeedChangedValue_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_dialogOptions.lv_optGameSpeed == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogControlSelectItem(gv_dialogOptions.lv_optGameSpeed, PlayerGroupAll(), BankValueGetAsInt(gv_sCMR, "options", "gamespeed"));
    if ((libNtve_gf_DialogItemValue(gv_dialogOptions.lv_optGameSpeed, 1) == 1.0)) {
        libNtve_gf_SetDialogItemText(gv_optGameSpeedLbl, libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedSlower, PlayerGroupAll());
    }

    if ((libNtve_gf_DialogItemValue(gv_dialogOptions.lv_optGameSpeed, 1) == 2.0)) {
        libNtve_gf_SetDialogItemText(gv_optGameSpeedLbl, libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedSlow, PlayerGroupAll());
    }
    else {
        if ((libNtve_gf_DialogItemValue(gv_dialogOptions.lv_optGameSpeed, 1) == 3.0)) {
            libNtve_gf_SetDialogItemText(gv_optGameSpeedLbl, libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedNormal, PlayerGroupAll());
        }
        else {
            if ((libNtve_gf_DialogItemValue(gv_dialogOptions.lv_optGameSpeed, 1) == 4.0)) {
                libNtve_gf_SetDialogItemText(gv_optGameSpeedLbl, libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedFast, PlayerGroupAll());
            }
            else {
                if ((libNtve_gf_DialogItemValue(gv_dialogOptions.lv_optGameSpeed, 1) == 5.0)) {
                    libNtve_gf_SetDialogItemText(gv_optGameSpeedLbl, libAA0EBE8C_gv_sCMRLauncher.lv_optSpeedFaster, PlayerGroupAll());
                }

            }
        }
    }
    return true;
}


    gt_GameSpeedChangedValue = TriggerCreate("gt_GameSpeedChangedValue_Func");
    TriggerAddEventDialogControl(gt_GameSpeedChangedValue, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeValueChanged);
}


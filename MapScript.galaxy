void gt_EpisodeButtonClicked_Init () {
    gt_EpisodeButtonClicked = TriggerCreate("gt_EpisodeButtonClicked_Func");
    TriggerAddEventDialogControl(gt_EpisodeButtonClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}


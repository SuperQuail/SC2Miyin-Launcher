                gf_SetDialogColorScheme("Assets\\Textures\\ui_battlenet_glue_navbuttons_blue_normalpressed.dds", "Assets\\Textures\\ui_battlenet_glue_navbuttons_blue_normaloverpressedover.dds", Color(74.90, 74.90, 100.00));

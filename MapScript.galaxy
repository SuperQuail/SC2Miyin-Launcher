bool gt_SaveOptions_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_dialogOptions.lv_optBtnOK == EventDialogControl()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    BankValueSetFromInt(gv_sCMR, "options", "gamespeed", FixedToInt(libNtve_gf_DialogItemValue(gv_dialogOptions.lv_optGameSpeed, 1)));
    BankValueSetFromInt(gv_sCMR, "options", "difficulty", DialogControlGetSelectedItem(gv_dialogOptions.lv_optDifficulty, 1));
    if ((gv_iniCinematicsMod == true)) {
        BankValueSetFromInt(gv_sCMR, "options", "InterstitialsNew", DialogControlGetSelectedItem(gv_dialogOptions.lv_optInterstitials, 1));
    }
    else {
        BankValueSetFromInt(gv_sCMR, "options", "InterstitialsNew", (DialogControlGetSelectedItem(gv_dialogOptions.lv_optInterstitials, 1) + 1));
    }
    BankValueSetFromInt(gv_sCMR, "options", "music", DialogControlGetSelectedItem(gv_dialogOptions.lv_optMusic, 1));

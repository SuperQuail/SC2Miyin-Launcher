//--------------------------------------------------------------------------------------------------
// Trigger: Ending - Credits
//--------------------------------------------------------------------------------------------------
bool gt_EndingCredits_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    DialogDestroy(gv_credits);
    libNtve_gf_HideScreenImage(false, 29);
    DialogCreate(1300, 900, c_anchorBottom, 0, 15, false);
    gv_credits = DialogLastCreated();
    DialogSetImageVisible(DialogLastCreated(), false);
    libNtve_gf_CreateDialogItemButton(gv_credits, 310, 60, c_anchorBottomRight, 50, 15, StringToText(""), libAA0EBE8C_gv_sCMRLauncher.lv_butClose, "Assets\\Textures\\ui_battlenet_glue_navbuttons_green_normaloverpressedover.dds");
    libNtve_gf_SetDialogItemImageType(DialogControlLastCreated(), c_triggerImageTypeEndCap, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\ui_battlenet_glue_navbuttons_green_normalpressed.dds", PlayerGroupAll());
    gv_creditsBtnOk = DialogControlLastCreated();
    TriggerEnable(gt_EndingCreditsfinish, true);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeCreditsPanel, true);
    DialogSetVisible(gv_credits, PlayerGroupAll(), true);
    TriggerSkippableBegin(PlayerGroupAll(), 1, gt_EndingCreditsclose, false, false);
    Wait(300.0, c_timeReal);
    return true;
}


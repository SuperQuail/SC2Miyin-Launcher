{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC2Miyin Launcher",
  "version": "0.1.0-alpha.2",
  "identifier": "net.miyin.launcher",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm -C ../ui dev",
    "beforeBuildCommand": "pnpm -C ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "弥音启动器",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}

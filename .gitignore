# ============================================================
# 弥音启动器 / MiYin Launcher — Git 忽略规则
# 原则：构建产物、依赖、本地配置、外部参考仓库一律不入库
# 注意：Cargo.lock **需要**提交（本项目是应用程序而非库）
# ============================================================

# ---------- 参考仓库（只读参考，禁止提交）----------
/reference/

# ---------- 原始美术素材（体积大且多为第三方版权，不入库）----------
# ui/public/ 下的压缩产物才是应用实际引用的文件
/assets-staging/

# ---------- Rust ----------
/target/
**/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata

# ---------- 前端 / Node（若采用 Tauri）----------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---------- 构建产物 / 安装包 ----------
/build/
/release/
/out/
*.msi
*.exe
!**/testdata/**/*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.nsis.zip

# ---------- 覆盖率 ----------
/coverage/
lcov.info
*.lcov

# ---------- 日志 ----------
*.log
/logs/

# ---------- 本地配置与环境变量 ----------
.env
.env.*
!.env.example
*.local
*.local.toml
/config/local.*
/secrets/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.suo
*.swp
*.swo

# ---------- 操作系统 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 本地沙箱 / 测试数据（可能含游戏版权内容，体积大）----------
/sandbox/
/testdata/StarCraft*

# 本地起 vite preview 时产生的日志
/ui/preview.*

# ---------- SC2 地图解包残留 ----------
# sc2diff 的 unpack 会把地图内容解到**当前目录**，在仓库根解一次就多出几十个文件
# （MapScript.galaxy、Triggers、t3* …）。全是暴雪版权内容，一律不入库；
# 要解包请解到 testdata/ 或系统临时目录。
/Assets/
/Base.SC2Data/
/enUS.SC2Data/
/MapScript.galaxy
/Triggers
/MapInfo
/Objects
/BankList.xml
/ComponentList.SC2Components
/DocumentHeader
/DocumentInfo
/PaintedPathingLayer
/Preload.xml
/PreloadAssetDB.txt
/Minimap.tga
/scmr_loading.dds
/t3*
/*.version


